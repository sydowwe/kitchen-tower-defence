{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"shell": "powershell",
						"command": "& '.claude/hooks/lint-edited-file.ps1'",
						"timeout": 30,
						"statusMessage": "Linting the edited file"
					}
				]
			}
		]
	}
}
