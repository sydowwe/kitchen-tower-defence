{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"types": ["node", "vite/client"],
		"jsx": "preserve",
		"useDefineForClassFields": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true,

		/* Strictness. noUncheckedIndexedAccess is required by steps/01-scaffold.md:
       the simulation indexes tile grids and entity arrays constantly, and this
       is what forces those lookups to be narrowed instead of assumed. */
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true,
		"erasableSyntaxOnly": true,

		/* No baseUrl: deprecated in TS 6. Paths resolve relative to this file. */
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.d.ts", "tests/**/*.ts", "*.config.ts"]
}
